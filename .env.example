# Copy to Vercel → Project → Settings → Environment Variables
# (Production + Preview). Never commit real values.

# Neon / Postgres. Required on Vercel so Clinic, Desk, and sign-in persist.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public URL of this deploy (no trailing slash).
BETTER_AUTH_URL=https://vibetok.vercel.app

# Random 32+ character secret for session cookies.
BETTER_AUTH_SECRET=

# Keep sign-in on in production.
VITE_AUTH_ENABLED=true

# Optional: xAI key for lesson-song and interview (server only).
# XAI_API_KEY=

# Voice line. Server only. Never put these in the browser.
# In Twilio, set the TwiML app Voice URL to POST https://YOUR-DOMAIN/api/voip
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY=
# TWILIO_API_SECRET=
# TWILIO_TWIML_APP_SID=
# TWILIO_CALLER_ID=
# TWILIO_AUTH_TOKEN=
# Meeting invites. Server only. onboarding@resend.dev can mail only the Resend account inbox
# until you verify your own domain and change RESEND_FROM.
# RESEND_API_KEY=
# RESEND_FROM=VibeTok <onboarding@resend.dev>

# Study Copilot. Server only. Never put these in the browser.
# OPENAI_API_KEY=
# NVD_API_KEY=
# GITHUB_TOKEN=

# Optional: Grok auth broker (injected by Grok App Builder when published there).
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
