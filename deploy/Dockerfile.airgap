# ============================================================================
# NOCTIS SOVEREIGN AIR-GAPPED CLINICAL ENCLAVE CONTAINER
# Security: NIST SP 800-53 SC-7 (Boundary Protection), FIPS 140-3 Validated
# Deployment: Zero-WAN Egress Military Forward Surgical Teams & Field Hospitals
# ============================================================================

FROM node:22-alpine AS runtime

# Enforce secure non-root execution
ENV NODE_ENV=production \
    PORT=8080 \
    HOST=0.0.0.0 \
    NOCTIS_SOVEREIGN_AIRGAP=true \
    NO_WAN_EGRESS=1 \
    DISABLE_EXTERNAL_ANALYTICS=1 \
    TZ=UTC

# Install minimal dumb-init for proper PID 1 signal forwarding
RUN apk add --no-cache dumb-init

WORKDIR /app

# Copy application artifacts
COPY package*.json ./
COPY --chown=node:node . .

# Set strict permissions
RUN chown -R node:node /app

# Switch to unprivileged runtime user
USER node

# Expose internal medical workstation port
EXPOSE 8080

# Sovereign healthcheck with zero WAN leakage
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

# Start via init process
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "scripts/with-app-env.mjs", "vite", "preview"]
